# Copy to .env and fill in. .env is gitignored — never commit real keys.
# In CI these come from GitHub Secrets instead.

# https://open-platform.theguardian.com/access/  (free, instant)
GUARDIAN_KEY=

# https://fredaccount.stlouisfed.org/apikeys  (free, instant) — Phase 2
FRED_KEY=

# Optional. Skipped entirely if absent.
NEWSAPI_KEY=

# Phase 4 only. Leave blank until the budget ledger exists.
ANTHROPIC_API_KEY=
